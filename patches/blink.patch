+  struct iovec parts[2] = {{&value, 3}, {(char *)&value + 3, 5}};
+  struct iovec dest[2] = {{&result, 5}, {(char *)&result + 5, 3}};
+  if ((fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC)) == -1) return 1;
+  if (!(fcntl(fd, F_GETFD) & FD_CLOEXEC) || !(fcntl(fd, F_GETFL) & O_NONBLOCK)) return 2;
+  if (read(fd, &result, 8) != -1 || errno != EAGAIN) return 3;
+  if (read(fd, &result, 0) != -1 || errno != EINVAL) return 4;
+  if (write(fd, &value, 7) != -1 || errno != EINVAL) return 5;
+  if ((ep = epoll_create1(EPOLL_CLOEXEC)) == -1) return 6;
+  if (epoll_ctl(ep, EPOLL_CTL_ADD, fd, &event)) return 7;
+  if (writev(fd, parts, 2) != 8) return 8;
+  if (epoll_wait(ep, &got, 1, 1000) != 1 || got.data.u64 != 42) return 9;
+  if (readv(fd, dest, 2) != 8 || result != value) return 10;
+  if (epoll_wait(ep, &got, 1, 0)) return 11;
+  close(ep);
+  close(fd);
+  if ((sem = eventfd(2, EFD_SEMAPHORE | EFD_NONBLOCK)) == -1) return 12;
+  if (read(sem, &result, 8) != 8 || result != 1) return 13;
+  if (read(sem, &result, 8) != 8 || result != 1) return 14;
+  if (read(sem, &result, 8) != -1 || errno != EAGAIN) return 15;
+  close(sem);
+  return 0;
+}
diff --git a/tool/eventfd_wakeup_probe.c b/tool/eventfd_wakeup_probe.c
new file mode 100644
index 0000000..ccf15e9
--- /dev/null
+++ b/tool/eventfd_wakeup_probe.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/epoll.h>
+#include <sys/eventfd.h>
+#include <time.h>
+#include <unistd.h>
+static int fd;
+static void *sender(void *unused) { uint64_t one=1;usleep(20000);if(write(fd,&one,8)!=8)_exit(3);return 0; }
+int main(void) {
+ int ep=epoll_create1(0);pthread_t thread;struct timespec a,b;
+ struct epoll_event ev={.events=EPOLLIN|EPOLLET},got;uint64_t value;
+ if(ep<0 || (fd=eventfd(0,EFD_NONBLOCK))<0)return 1;
+ if(epoll_ctl(ep,EPOLL_CTL_ADD,fd,&ev))return 2;
+ clock_gettime(CLOCK_MONOTONIC,&a);
+ if(pthread_create(&thread,0,sender,0))return 4;
+ int n=epoll_wait(ep,&got,1,1000);
+ clock_gettime(CLOCK_MONOTONIC,&b);
+ double elapsed=(b.tv_sec-a.tv_sec)+(b.tv_nsec-a.tv_nsec)/1e9;
+ printf("events=%d elapsed=%.6f\n",n,elapsed);
+ pthread_join(thread,0);
+ if(n!=1)return 5;
+ if(read(fd,&value,8)!=8 || value!=1)return 6;
+ return elapsed>0.5 ? 7 : 0;
+}
